PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
ENABLE_NOTIFICATIONS=false
DATABASE_URL=sqlite:///data/job_radar.db

# Optional second notification channel — email, independent of Pushover.
# Either this block or the Pushover keys above (or both) can satisfy
# ENABLE_NOTIFICATIONS=true. SMTP_USERNAME/PASSWORD are for the SENDING
# account (often needs an app password, not your regular login password,
# if that account has 2FA enabled) — EMAIL_TO is just the destination.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
MATCH_ALERT_THRESHOLD=80
IMMEDIATE_ALERT_THRESHOLD=88
SEARCH_LOOKBACK_DAYS=30
LOG_LEVEL=INFO

# Optional — only needed for the government (USAJOBS) collector added in Phase 4.
# Free key: https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_EMAIL=
